#!/bin/sh
# Inspect the exact commits being pushed, not an unrelated working-tree state.
while read -r local_ref local_sha remote_ref remote_sha
do
  case "$local_sha" in
    0000000000000000000000000000000000000000) continue ;;
  esac
  node scripts/check-public-files.mjs --ref "$local_sha" --history || exit 1
done
