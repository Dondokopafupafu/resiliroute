{
  "name": "resiliroute",
  "version": "3.0.0",
  "private": true,
  "description": "An explainable urban mobility resilience decision-support prototype.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "analyze:data": "vitest run tests/data-audit.test.ts --reporter=verbose",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "screenshots:real-city": "node scripts/capture-real-city-screenshots.mjs",
    "screenshots:decision": "node scripts/capture-decision-screenshots.mjs",
    "check:public": "node scripts/check-public-files.mjs --staged --history"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "leaflet": "1.9.4",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "5.0.0",
    "recharts": "3.10.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.8",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.0.0"
  }
}
