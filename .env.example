# Optional. Without a key, all simulation and local analysis features work.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_URL=https://overpass.private.coffee/api/interpreter
# POST is the default. GET is available for a configured service that supports it.
OVERPASS_HTTP_METHOD=POST
